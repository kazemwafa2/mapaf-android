<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="14dp"
    android:background="@drawable/bg_card" android:layout_marginBottom="6dp"
    android:clickable="true" android:focusable="true" android:gravity="center_vertical">
    <TextView android:id="@+id/pc_code" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="16sp" android:textStyle="bold" android:textColor="@color/primary"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/pc_area" style="@style/ListHeader"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/pc_sub" style="@style/ListSub"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
